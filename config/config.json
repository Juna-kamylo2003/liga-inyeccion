{
  "development": {
    "username": "root",
    "password": "",
    "database": "ligas_db",
    "host": "127.0.0.1",
    "port": 3306,
    "dialect": "mariadb",
    "logging": false
  },
  "test": {
    "username": "root",
    "password": "",
    "database": "ligas_db_test",
    "host": "127.0.0.1",
    "port": 3306,
    "dialect": "mariadb",
    "logging": false
  },
  "production": {
    "username": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "database": "${DB_NAME}",
    "host": "${DB_HOST}",
    "port": 3306,
    "dialect": "mariadb",
    "logging": false,
    "dialectOptions": {
      "connectTimeout": 60000,
      "acquireTimeout": 60000,
      "timeout": 60000,
      "multipleStatements": true
    },
    "pool": {
      "max": 5,
      "min": 0,
      "acquire": 30000,
      "idle": 10000
    }
  }
}
